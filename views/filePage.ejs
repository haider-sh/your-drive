<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>YourDrive</title>
    <script src="/deletion.js" defer></script>
</head>

<body>
    <div class="container">
        <%- include("header") %>
            <div class="content">
                <div class="file-card">
                    <div class="icon">
                        <% if(file.path.endsWith("png") || file.path.endsWith("jpeg") || file.path.endsWith("jpg") || file.path.endsWith("webp") || file.path.endsWith("svg") || file.path.endsWith("gif")) {%>
                            <img src="<%=file.path%>" alt="Image Preview">
                        <% } else {%>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            class="lucide lucide-file-text-icon lucide-file-text">
                            <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                            <path d="M14 2v4a2 2 0 0 0 2 2h4" />
                            <path d="M10 9H8" />
                            <path d="M16 13H8" />
                            <path d="M16 17H8" />
                        </svg>
                        <%}%>
                    </div>
                    <div class="info">
                        <div class="date"> Created on <%=formatDateFileCard(file.created)%>
                        </div>
                        <div class="size">
                            <%=(file.size / (1024 * 1024)).toFixed(2)%>mb
                        </div>
                    </div>
                    <div class="name-actions">
                        <div class="name">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round"
                                class="lucide lucide-file-chart-column-increasing-icon lucide-file-chart-column-increasing">
                                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                                <path d="M14 2v4a2 2 0 0 0 2 2h4" />
                                <path d="M8 18v-2" />
                                <path d="M12 18v-4" />
                                <path d="M16 18v-6" />
                            </svg>
                            <%=file.name%>
                        </div>
                        <div class="actions">
                            <a
                                href="https://res.cloudinary.com/<%=cloudName%>/image/upload/fl_attachment/<%=publicId %>" download="<%=file.name%>">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="lucide lucide-arrow-down-to-line-icon lucide-arrow-down-to-line">
                                    <path d="M12 17V3" />
                                    <path d="m6 11 6 6 6-6" />
                                    <path d="M19 21H5" />
                                </svg>
                            </a>
                            <% if(locals.currentUser && currentUser.id === file.folder.user_id) {%>
                            <a href="delete/<%=file.id%>" id="file-deletion">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round" class="lucide lucide-trash-icon lucide-trash">
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
                                    <path d="M3 6h18" />
                                    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                </svg>
                            </a>
                            <%}%>
                        </div>
                    </div>
                </div>
            </div>
    </div>
</body>

</html>