<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>YourDrive</title>
</head>
<body>
    <div class="container">
        <%- include("header") %>
        <div class="form">
            <h2><%= type === "create" ? "Create new folder" : "Edit folder name" %></h2>
            <form action="/folder/<%=type.toLowerCase()%>/<%= locals.folder ? folder.id : null %>" method="post">
                <div>
                    <label for="foldername">Folder Name:</label>
                    <input type="text" name="foldername" id="foldername" value="<%= locals.folder ? folder.name : null %>" required>
                </div>              
                <button type="submit"><%=type%></button>
            </form>
        </div>
    </div>
</body>
</html>