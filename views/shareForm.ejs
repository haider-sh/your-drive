<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>YourDrive</title>
</head>
<body>
    <div class="container">
        <%- include("header") %>
        <div class="form">
            <h2>Share File</h2>
            <form action="<%=id%>" method="post">
                <div>
                    <label for="validity">Validity (in days):</label>
                    <input type="number" name="duration" id="validity" min="1" required>
                </div>              
                <button type="submit">Create Link</button>
            </form>
        </div>
    </div>
</body>
</html>