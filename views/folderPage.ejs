<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>YourDrive</title>
</head>

<body>
    <div class="container">
        <%- include("header") %>
            <div class="content">
                <% if(!folder || (locals.currentUser && currentUser.id===folder.user_id)) {%>
                    <a href="/folder/<%=id%>/file/create" class="add">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            class="lucide lucide-circle-plus-icon lucide-circle-plus">
                            <circle cx="12" cy="12" r="10" />
                            <path d="M8 12h8" />
                            <path d="M12 8v8" />
                        </svg>
                        New File
                    </a>
                    <%}%>
                        <h2>
                            <%=folder ? folder.name : "My Folder" %>/Files
                        </h2>
                        <div class="files">
                            <div class="heading">
                                <div class="name">Name</div>
                                <div class="date">Uploaded Date</div>
                                <div class="author">Uploaded By</div>
                            </div>
                            <% files.map(file=> {%>
                                <div class="file">
                                    <a href="/folder/<%=id%>/file/<%=file.id%>" class="name">
                                        <div class="icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round"
                                                class="lucide lucide-file-chart-column-increasing-icon lucide-file-chart-column-increasing">
                                                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                                                <path d="M14 2v4a2 2 0 0 0 2 2h4" />
                                                <path d="M8 18v-2" />
                                                <path d="M12 18v-4" />
                                                <path d="M16 18v-6" />
                                            </svg>
                                        </div>
                                        <%=file.name%>
                                    </a>
                                    <div class="date">
                                        <%=formatDateFileGrid(file.created)%>
                                    </div>
                                    <div class="author">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" stroke-linejoin="round"
                                            class="lucide lucide-user-round-icon lucide-user-round">
                                            <circle cx="12" cy="8" r="5" />
                                            <path d="M20 21a8 8 0 0 0-16 0" />
                                        </svg>
                                        <% if(locals.currentUser && currentUser.id===folder.user_id){%>
                                            You
                                            <%} else {%>
                                                <%= folder.user.username %>
                                                    <%}%>
                                    </div>
                                </div>
                                <%})%>
                        </div>
            </div>
    </div>
</body>

</html>