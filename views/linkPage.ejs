<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>YourDrive</title>
    <script defer>
        function copyLink() {
            let linkText = document.querySelector(".link");
            // linkText.select();
            //linkText.setSelectionRange(0,10000);
            navigator.clipboard.writeText(linkText.textContent);

            const copiedButton = document.querySelector(".copy-text");
            copiedButton.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-check-icon lucide-clipboard-check"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/></svg>
            `
            alert("Link copied to clipboard.");
        }
    </script>
</head>

<body>
    <div class="container">
        <%- include("header") %>
            <div class="content">
                <div class="link-div">
                    <div class="link">
                        <%=link%>       
                        <button onclick="copyLink()" style="cursor: pointer;" class="copy-text">                 
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-icon lucide-clipboard"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>
                        </button>
                    </div>
                </div>
            </div>
    </div>
</body>

</html>