generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("CLOUD_DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  username String   @unique
  password String
  created  DateTime @default(now())
  folders  Folder[]
}

model Folder {
  id       Int      @id @default(autoincrement())
  name     String
  created  DateTime @default(now())
  user_id  Int
  isShared Boolean  @default(false)
  files    File[]
  user     User     @relation(fields: [user_id], references: [id])
  shares   Shared[]
}

model File {
  id        Int      @id @default(autoincrement())
  name      String
  size      Int
  created   DateTime @default(now())
  folder_id Int
  path      String
  folder    Folder   @relation(fields: [folder_id], references: [id], onDelete: Cascade)
}

model Shared {
  id         String   @id
  folder_id  Int
  start_time DateTime @default(now())
  duration   Int
  folder     Folder   @relation(fields: [folder_id], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}
